    {
        "id": "76ee39ad44bb3390",
        "type": "function",
        "z": "6d4114a05924097a",
        "name": "getBarrierState",
        "func": "// (Assuming your MQTT node is set to output a parsed JSON Object)\nvar data = msg.payload;\n\n// 2. Check if the specific property exists\nif (data && data.hasOwnProperty(\"isBarrierOpen\")) {\n    \n    // 3. Set the payload to the boolean value\n    // This effectively strips away the rest of the object\n    msg.payload = data.isBarrierOpen;\n    \n    // 4. Send the message to the LED\n    return msg;\n}\n\n// 5. If the property doesn't exist, return null\n// This stops the flow completely, so the LED ignores this message.\nreturn null;",
        "outputs": 1,
