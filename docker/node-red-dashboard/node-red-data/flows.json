    {
        "id": "d081a28c8f0d2ee0",
        "type": "function",
        "z": "6d4114a05924097a",
        "name": "Logging",
        "func": "// Get the current log from context (or start empty)\nvar currentLog = flow.get(\"myLog\") || \"\";\n\n// Add the new message to the top (or bottom)\n// <br> creates a new line in HTML\nvar newLine = new Date().toLocaleTimeString() + \": \" + msg.payload + \"<br>\";\n\n// Combine them (Newest on top)\ncurrentLog = newLine + currentLog;\n\n// OPTIONAL: Limit the log size so your browser doesn't crash\n// This keeps roughly the last 5000 characters\nif (currentLog.length > 5000) {\n    currentLog = currentLog.substring(0, 5000);\n}\n\n// Save it back to context\nflow.set(\"myLog\", currentLog);\n\n// Send to the Dashboard Text Node\nmsg.payload = currentLog;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
